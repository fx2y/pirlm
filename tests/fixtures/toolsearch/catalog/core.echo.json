{
  "name": "core.echo",
  "description": "Echoes back the input. Use for testing. When NOT to use: do not use for logging.",
  "input_schema": {
    "type": "object",
    "properties": {
      "msg": {"type": "string", "description": "The message to echo"}
    },
    "required": ["msg"]
  },
  "input_examples": [
    {"msg": "hello"},
    {"msg": "world"},
    {"msg": "ping"}
  ],
  "idempotent": true,
  "cacheable": true,
  "max_payload_bytes": 4096,
  "timeout_s": 5,
  "retry": {"max_attempts": 1},
  "allowed_callers": ["code_exec"],
  "tags": ["utility"],
  "defer_loading": false
}
