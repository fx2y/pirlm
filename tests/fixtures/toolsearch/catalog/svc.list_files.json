{
  "name": "svc.list_files",
  "description": "Lists files in a directory. Use for exploration. When NOT to use: do not use for deletion.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "description": "The directory path"}
    },
    "required": ["path"]
  },
  "input_examples": [
    {"path": "/home"},
    {"path": "/tmp"},
    {"path": "."}
  ],
  "idempotent": true,
  "cacheable": true,
  "max_payload_bytes": 8192,
  "timeout_s": 6,
  "retry": {"max_attempts": 1},
  "allowed_callers": ["code_exec"],
  "tags": ["fs", "exploration"],
  "defer_loading": true
}
