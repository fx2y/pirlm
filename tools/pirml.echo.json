{
  "name": "pirml.echo",
  "description": "Echoes back the input text. Use this to verify communication. When NOT to use: do not use for complex processing.",
  "input_schema": {
    "type": "object",
    "required": ["text"],
    "properties": {
      "text": {"type": "string"}
    }
  },
  "input_examples": [
    {"text": "hello"},
    {"text": "deterministic reply only"},
    {"text": "trace-safe echo sample"}
  ],
  "idempotent": true,
  "cacheable": true,
  "max_payload_bytes": 4096,
  "timeout_s": 5,
  "retry": {"max_attempts": 1},
  "allowed_callers": ["code_exec"],
  "tags": ["utility", "debug"],
  "defer_loading": false
}
