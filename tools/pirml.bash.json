{
  "name": "pirml.bash",
  "description": "Executes a shell command. Returns stdout and stderr. When NOT to use: do not use for long-running processes or interactive commands.",
  "input_schema": {
    "type": "object",
    "required": ["command"],
    "properties": {
      "command": {"type": "string"}
    }
  },
  "input_examples": [
    {"command": "ls -la"},
    {"command": "pwd"},
    {"command": "echo ready"}
  ],
  "idempotent": false,
  "cacheable": false,
  "max_payload_bytes": 32768,
  "timeout_s": 10,
  "retry": {"max_attempts": 0},
  "allowed_callers": ["code_exec"],
  "tags": ["system", "exec"],
  "defer_loading": false
}
