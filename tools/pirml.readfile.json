{
  "name": "pirml.readfile",
  "description": "Reads a file from the filesystem. Returns UTF-8 content. When NOT to use: do not use for binary files or very large files without max_bytes.",
  "input_schema": {
    "type": "object",
    "required": ["path"],
    "properties": {
      "path": {"type": "string"},
      "max_bytes": {"type": "integer"}
    }
  },
  "input_examples": [
    {"path": "README.md", "max_bytes": 1024},
    {"path": "pyproject.toml", "max_bytes": 512},
    {"path": "docs/INSTALL.md", "max_bytes": 2048}
  ],
  "idempotent": true,
  "cacheable": true,
  "max_payload_bytes": 16384,
  "timeout_s": 8,
  "retry": {"max_attempts": 1},
  "allowed_callers": ["code_exec"],
  "tags": ["fs", "io"],
  "defer_loading": false
}
