{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolManifest",
  "type": "object",
  "required": ["name", "description", "input_schema"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "input_schema": {
      "type": "object"
    },
    "input_examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "idempotent": {
      "type": "boolean"
    },
    "cacheable": {
      "type": "boolean"
    },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "retry": {
      "type": "object",
      "required": ["max_attempts"],
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "allowed_callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["direct", "code_exec"]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defer_loading": {
      "type": "boolean"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verbs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nouns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
