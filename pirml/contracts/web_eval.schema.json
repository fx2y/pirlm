{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebEvalRow",
  "type": "object",
  "required": [
    "qid",
    "plan",
    "acc",
    "fetches",
    "bytes",
    "chunks",
    "cache_hit",
    "fail_tag",
    "timeout_s",
    "latency_ms",
    "cost_usd",
    "tokens_in",
    "tokens_out",
    "bytes_into_model",
    "tool_calls",
    "fanout_peak",
    "invalid_output",
    "no_cite",
    "replay_match"
  ],
  "additionalProperties": false,
  "properties": {
    "qid": { "type": "string", "minLength": 1 },
    "plan": { "type": "string", "minLength": 1 },
    "acc": { "type": "number" },
    "fetches": { "type": "integer", "minimum": 0 },
    "bytes": { "type": "integer", "minimum": 0 },
    "chunks": { "type": "integer", "minimum": 0 },
    "cache_hit": { "type": "number" },
    "fail_tag": { "type": "string" },
    "timeout_s": { "type": "number", "minimum": 0 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "tokens_in": { "type": "integer", "minimum": 0 },
    "tokens_out": { "type": "integer", "minimum": 0 },
    "bytes_into_model": { "type": "integer", "minimum": 0 },
    "tool_calls": { "type": "integer", "minimum": 0 },
    "fanout_peak": { "type": "integer", "minimum": 0 },
    "invalid_output": { "type": "boolean" },
    "no_cite": { "type": "boolean" },
    "replay_match": { "type": "boolean" },
    "note": { "type": "string" }
  }
}
